root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# ktlint, run by Spotless: the Android Studio style, which the IDE formatter also follows.
ktlint_code_style = android_studio
# Composable functions are named like types, in PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
# The design system's theme values and content color: the only CompositionLocals so far.
compose_allowed_composition_locals = LocalStudioColors,LocalStudioTypography,LocalStudioDimens,LocalStudioShapes,LocalStudioMotion,LocalStudioEffects,LocalStudioContentColor,LocalGlassBackdrop,LocalWindowFeedback,LocalFeedbackWindowDepth

[*.{ts,json,yml,yaml,md}]
indent_size = 2

[app/src/main/kotlin/com/illiamelnyk/studio/core/ui/foundation/LocalWindowFeedback.kt]
compose_allowed_composition_locals = LocalWindowFeedback,LocalFeedbackWindowDepth
