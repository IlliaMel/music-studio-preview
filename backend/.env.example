# Copy to .env for local work. Every value is optional: without any, the server runs on
# http://127.0.0.1:8787 with an embedded Postgres (PGlite) in ./data.
# Variables set in the real environment win over this file.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787

LOG_LEVEL=info
# Human-readable logs in the terminal; JSON lines when false (what hosting platforms expect).
LOG_PRETTY=true

# Postgres connection string, e.g. postgresql://user:password@host:5432/studio.
# Leave empty to use PGlite: a real Postgres running inside the Node process, nothing to install.
DATABASE_URL=
DATA_DIR=./data

# firebase: checks real Firebase ID tokens (the default in production).
# dev: accepts "Bearer dev:<name>" as the user <name>; loopback by default, never in production.
AUTH_MODE=dev
# Physical-phone testing only: true allows a literal RFC1918 HOST in development.
# Bind to the computer's private IPv4, never 0.0.0.0; use a trusted LAN and separate test DATA_DIR.
ALLOW_LAN_DEV_AUTH=false
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file as one line in single quotes. Never commit it.
FIREBASE_SERVICE_ACCOUNT=
# Alternative path to the backend admin credential JSON (never Android google-services.json).
FIREBASE_SERVICE_ACCOUNT_FILE=
# false keeps Firebase identities when this environment shares a Firebase project.
# SQL data and local audio are still deleted; production normally keeps true.
FIREBASE_DELETE_USERS=true

# Base of the audio links the app receives, e.g. https://api.example.com. Required in production.
# Leave empty locally: the address the request came to is right for the emulator and adb reverse.
PUBLIC_BASE_URL=
# Where generated audio files are kept. Defaults to DATA_DIR/audio; in production it is required and must be
# a persistent volume, or every deploy loses the audio.
AUDIO_DIR=

# Music generation. Mock uses no credits. ElevenLabs uses real paid API calls.
MUSIC_PROVIDER=mock
ELEVENLABS_API_KEY=
# Audio references come with every paid plan and are on by default; set false to turn them off.
# Each reference upload is billed like one generation.
ELEVENLABS_ENABLE_REFERENCES=true
GENERATION_CONCURRENCY=2
GENERATION_TIMEOUT_MS=300000
DAILY_GENERATIONS_PER_USER=25
# Optional verified-email allowlist, comma-separated and case-insensitive.
# Example: someone@example.com. Empty preserves unrestricted local generation.
# Required and non-empty when MUSIC_PROVIDER=elevenlabs with AUTH_MODE=firebase.
GENERATION_ALLOWED_EMAILS=
# Optional global UTC-day cap on paid upstream requests; two variants reserve two.
# A new audio reference reserves one additional upload; cached remote references do not.
# Uncertain failures and deletion keep reservations; proven unspent refusals refund.
# Required with elevenlabs and AUTH_MODE=firebase; empty leaves the cap disabled locally.
DAILY_PAID_REQUESTS_TOTAL=
# How long the mock "thinks"; long enough to see the generating state in the app.
MOCK_DELAY_MS=8000
